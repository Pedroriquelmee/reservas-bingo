# Copia este archivo como .env.local (desarrollo) y rellena los valores.
# En producción, crea las mismas variables en Vercel → Settings → Environment Variables.
# NO subas nunca .env.local a GitHub.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# Es pública por diseño: la seguridad la ponen RLS y las funciones del servidor.
# NUNCA pongas aquí la "secret key" ni la "service_role key".
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Texto de la página de privacidad
VITE_RESPONSABLE_TRATAMIENTO=Grupo Scout Alba 601
VITE_CONTACTO_PRIVACIDAD=correo-de-contacto@ejemplo.com

# --- Solo para pruebas locales (no van en Vercel) ---
# PostgreSQL DESECHABLE para npm run test:db y npm run test:e2e. Jamás el de producción.
# DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/postgres
