{
  "name": "reservas-bingo",
  "version": "1.0.0",
  "private": true,
  "description": "Reservas de plazas para ayudar en los domingos de bingo (React + Supabase).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:todo": "npm run typecheck && npm run test && npm run test:db",
    "test:e2e": "playwright test",
    "comprobar": "node scripts/comprobar-produccion.mjs",
    "demo": "node demo/iniciar.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
